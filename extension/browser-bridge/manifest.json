{
  "manifest_version": 3,
  "name": "Automation Test WebHelper",
  "version": "0.2.0",
  "description": "Lets the Automation Test program control tabs of this browser (open URLs, click, type, read) through a local connection.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Automation Test WebHelper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["debugger", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
